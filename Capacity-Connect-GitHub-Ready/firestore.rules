rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Secure baseline: deny all client access by default.
    // The current public demo uses localStorage unless Firebase sync is explicitly configured.
    // If you enable cloud sync, replace this with role-aware rules backed by Firebase Authentication.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
